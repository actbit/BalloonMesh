{$PUBLIC_DOMAIN} {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Caddy forwards HTTP upgrades, so the application WebSocket endpoints
    # (/ws/gateway and /hubs/monitor) work through the same HTTPS origin.
    reverse_proxy server:5080
}
