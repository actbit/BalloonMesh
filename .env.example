# Wi-Fi 設定（ESP32 実機接続用）
BM_WIFI_SSID="your-wifi-ssid"
BM_WIFI_PASS="your-wifi-password"

# Gateway firmware build-time configuration (do not commit real credentials)
BM_GATEWAY_ID="gw-01"
BM_SERVER_URL="https://example.com"
BM_GATEWAY_TOKEN="set-a-deployment-token"

# Local Identity 初期ユーザー（AUTH_MODE=Local の場合）
AUTH_MODE="Local"
BALLOONMESH_ADMIN_PASSWORD="set-a-strong-password"

# Lightsail HTTPS deployment (used with compose.https.yml)
PUBLIC_DOMAIN="mesh.example.com"
