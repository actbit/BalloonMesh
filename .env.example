# Wi-Fi 設定（ESP32 実機接続用）
BM_WIFI_SSID="your-wifi-ssid"
BM_WIFI_PASS="your-wifi-password"

# Gateway firmware build-time configuration (do not commit real credentials)
# BM_GATEWAY_TOKEN is issued per gateway from the server's admin UI
# (Gateway tokens panel) and is only valid for the BM_GATEWAY_ID it was
# issued for.  It is shown once at issue time and cannot be recovered.
BM_GATEWAY_ID="gw-01"
BM_SERVER_URL="https://example.com"
BM_GATEWAY_TOKEN="issue-one-from-the-admin-ui"

# Local Identity 初期ユーザー（AUTH_MODE=Local の場合）
AUTH_MODE="Local"
BALLOONMESH_ADMIN_PASSWORD="set-a-strong-password"
