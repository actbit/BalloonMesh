<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BalloonMesh.Server</RootNamespace>
    <AssemblyName>BalloonMesh.Server</AssemblyName>
    <SvelteSharpBuildTaskAssembly>$(MSBuildThisFileDirectory)..\third_party\SvelteSharp\SvelteSharp.Build\bin\$(Configuration)\net10.0\SvelteSharp.Build.dll</SvelteSharpBuildTaskAssembly>
    <SvelteSharpViewsPath>$(MSBuildThisFileDirectory)Views</SvelteSharpViewsPath>
    <SvelteSharpToolchainPath>$(MSBuildThisFileDirectory)tools\svelte</SvelteSharpToolchainPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project and the protocol class library live below this
         directory; keep them out of the web app's default globs. -->
    <Compile Remove="BalloonMesh.Server.Tests\**\*.cs" />
    <Content Remove="BalloonMesh.Server.Tests\**" />
    <None Remove="BalloonMesh.Server.Tests\**" />
    <Compile Remove="BalloonMesh.Protocol\**\*.cs" />
    <Content Remove="BalloonMesh.Protocol\**" />
    <None Remove="BalloonMesh.Protocol\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BalloonMesh.Protocol\BalloonMesh.Protocol.csproj" />
    <ProjectReference Include="..\third_party\SvelteSharp\SvelteSharp.Core\SvelteSharp.Core.csproj" />
    <ProjectReference Include="..\third_party\SvelteSharp\SvelteSharp.Jint\SvelteSharp.Jint.csproj" />
    <ProjectReference Include="..\third_party\SvelteSharp\SvelteSharp.Build\SvelteSharp.Build.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- SvelteSharp ships this target in its NuGet package; the repository sample
       imports it directly when using project references. -->
  <Import Project="..\third_party\SvelteSharp\SvelteSharp.Build\buildTransitive\SvelteSharp.Build.targets" />

</Project>
